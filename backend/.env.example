# Local backend profile
SPRING_PROFILES_ACTIVE=postgres

# Local PostgreSQL from docker-compose.db.yml (development only)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/b26
SPRING_DATASOURCE_USERNAME=b26
SPRING_DATASOURCE_PASSWORD=b26-local-only

# For hosted PostgreSQL, replace the connection settings above, including sslmode if required.

# Optional: alternate administrator credential for system route updates
APP_ADMIN_TOKEN=

# Optional: auth mode
# true  -> email + password signin
# false -> email-only signin (dev convenience)
APP_AUTH_REQUIRE_PASSWORD=true

# Optional: comma-separated CORS allowlist (used in deploy)
# APP_CORS_ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app

# Optional local search demo accounts (disabled by default; excluded from prod)
APP_DEMO_USERS_ENABLED=false
